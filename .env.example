# =========================================================================
# Feishu / Lark App Credentials
# =========================================================================

# Complete official keys (Recommended)
FEISHU_APP_ID=cli_xxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alternatively, short keys (also supported)
APP_ID=cli_xxxxxxxxxxxxxx
APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =========================================================================
# Access control
# -------------------------------------------------------------------------
# 新权限体系（推荐）：
#   首次部署后，第一个私聊会话自动绑定为最高管理员（admin）。
#   其他会话默认静默，发送 /auth 申请权限，管理员通过 /user 或授权卡片审批。
#
# 旧白名单兼容（可选，配置后命中者自动视为已授权 user，开发档权限）：
#   ALLOWED_USERS / ALLOWED_CHATS 为逗号分隔的 open_id / chat_id。
#   留空 = 完全走新权限体系（未授权会话不可用）。
# =========================================================================
ALLOWED_USERS=
ALLOWED_CHATS=

# =========================================================================
# Antigravity / agy engine (portability)
# =========================================================================

# Absolute path to agy/antigravity binary. Leave empty for auto-detect.
ANTIGRAVITY_BIN=

# Data root for antigravity-cli (transcripts, oauth token, global memory).
# Default: ~/.gemini/antigravity-cli
ANTIGRAVITY_HOME=

# Default workspace root used by the project browser card.
# Default: ~
WORKSPACE_ROOT=

# When true, pass --dangerously-skip-permissions to agy for ADMIN chats only.
# Regular authorized users never get this flag, regardless of this setting.
# DANGEROUSLY_SKIP_PERMISSIONS=true

# Optional git mirror used by /update when GitHub is unreachable.
# May embed credentials, e.g. https://user:token@gitee.com/user/repo.git
GITEE_MIRROR_URL=

# =========================================================================
# Docker Compose helpers (optional)
# =========================================================================
# HOST_ANTIGRAVITY_HOME=${HOME}/.gemini/antigravity-cli
# HOST_WORKSPACE=${HOME}
